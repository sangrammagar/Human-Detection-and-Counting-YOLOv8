
import cv2
from ultralytics import YOLO

# 1. Load the YOLOv8 model
model = YOLO('yolov8n.pt')

# 2. Point to your video file path
video_path = "Enter Loacal Path Here in Mp4 Format"  ###
cap = cv2.VideoCapture(video_path)

# Check if the video opened successfully
if not cap.isOpened():
    print("Error: Could not open video.")
    exit()

while cap.isOpened():
    success, frame = cap.read()
   
    # If the video ends, success will be False
    if not success:
        print("Video stream ended.")
        break

    # Run YOLOv8 detection (filtered to person class)
    results = model(frame, classes=[0], conf=0.5, verbose=False)

    # Get the number of people detected
    person_count = len(results[0].boxes)

    # Draw the results on the frame
    annotated_frame = results[0].plot()

    # Add the count text
    cv2.putText(
        annotated_frame,
        f'People Count: {person_count}',
        (20, 50),
        cv2.FONT_HERSHEY_SIMPLEX,
        1.5,
        (0, 255, 0),
        3
    )

    # Display the frame
    cv2.imshow("Video People Counter", annotated_frame)

    if cv2.waitKey(25) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
