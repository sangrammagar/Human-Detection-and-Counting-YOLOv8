import cv2
from ultralytics import YOLO

# Load a pre-trained YOLOv8 model (nano version for speed)
model = YOLO('yolov8n.pt')

# Initialize webcam 
cap = cv2.VideoCapture(0)

while cap.isOpened():
    success, frame = cap.read()
    if not success:
        break

    # Run YOLOv8 detection on the frame
    # classes=[0] filters the detection to only show 'person'
    results = model(frame, classes=[0], conf=0.5, verbose=False)

    # Get the number of people detected
    person_count = len(results[0].boxes)

    # Draw the results on the frame
    annotated_frame = results[0].plot()

    # Add the count text to the top left
    cv2.putText(
        annotated_frame, 
        f'People Count: {person_count}', 
        (20, 50),                   # Coordinates (x, y)
        cv2.FONT_HERSHEY_SIMPLEX,   # Font
        1.5,                        # Font scale
        (0, 255, 0),                # Color (BGR - Green)
        3                           # Thickness
    )

    # Display the frame
    cv2.imshow("Real-Time People Counter", annotated_frame)

    # Break loop on 'q' key press
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
